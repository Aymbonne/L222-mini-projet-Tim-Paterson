{% extends 'base.html.twig' %}

{% block title %}Liste des articles{% endblock %}

{% block body %}
<div class="container mt-4">

    <h1 class="mb-4">Liste des articles</h1>

    <div class="row">
        {% for article in articles %}
            <div class="col-md-4 mb-4">
                <div class="card article-card h-100">
                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">{{ article.title }}</h5>

                        <p class="text-muted mb-1">
                            {% if article.Category.name is defined %}
                                Catégorie : {{ article.Category.name }}
                            {% endif %}
                        </p>

                        <p class="text-muted mb-2">
                            {% if article.Author.email is defined %}
                                Auteur : {{ article.Author.email }}
                            {% endif %}
                        </p>

                        <p class="card-text flex-grow-1">
                            {{ article.content|slice(0, 120) }}...
                        </p>

                        <div class="mt-auto">
                            <a href="{{ path('article_show', {'id': article.id}) }}"
                               class="btn btn-primary btn-sm">
                                Voir plus
                            </a>

                            {% if app.user and (article.Author == app.user or app.user.id == 1) %}
                                <a href="{{ path('article_edit', {'id': article.id}) }}"
                                   class="btn btn-outline-secondary btn-sm ms-2">
                                    Modifier
                                </a>
                            {% endif %}
                        </div>

                    </div>
                </div>
            </div>
        {% else %}
            <p>Aucun article trouvé.</p>
        {% endfor %}
    </div>

</div>
{% endblock %}
