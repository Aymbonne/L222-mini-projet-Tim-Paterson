{% extends 'base.html.twig' %}

{% block title %}Liste des articles{% endblock %}

{% block body %}
<div class="text-center mb-5">
    <h1 class="fw-bold text-dark display-5">Liste des articles</h1>
    <div class="d-flex justify-content-center mt-3">
        {% if app.user %}
            <a href="{{ path('article_new') }}" class="btn btn-primary shadow-sm px-4">
                <i class="fas fa-plus-circle me-2"></i> Créer un nouvel article
            </a>
        {% endif %}
    </div>
    <hr class="mx-auto bg-primary opacity-75" style="width: 100px; height: 3px;">
</div>

    <div class="row g-4">
        {% for article in articles %}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-primary py-1"></div>
                    
                    <div class="card-body d-flex flex-column p-4">
                        <h5 class="card-title fw-bold text-primary">{{ article.title }}</h5>

                        <div class="mb-3">
                            {% if article.Category.name is defined %}
                                <span class="badge bg-info text-dark rounded-pill">
                                    <i class="fas fa-tag me-1"></i> {{ article.Category.name }}
                                </span>
                            {% endif %}
                        </div>

                        <p class="card-text text-muted flex-grow-1">
                            {{ article.content|slice(0, 120) }}...
                        </p>

                        <div class="mt-4 pt-3 border-top">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="btn-group">
                                    <a href="{{ path('article_show', {'id': article.id}) }}" class="btn btn-primary btn-sm px-3">
                                        Voir plus
                                    </a>
                                    
                                    {% if app.user and (article.Author == app.user or app.user.id == 1) %}
                                        <a href="{{ path('article_edit', {'id': article.id}) }}" class="btn btn-outline-warning btn-sm ms-2 px-3">
                                            Modifier
                                        </a>
                                    {% endif %}
                                </div>
                                
                                <small class="text-secondary">
                                    <i class="far fa-user me-1"></i> 
                                    {% if article.Author %}
                                    {{ article.Author.email|split('@')[0]|capitalize }}
                                    {% else %}
                                    Anonyme
                                    {% endif %}
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <p class="text-muted italic">Aucun article trouvé.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
