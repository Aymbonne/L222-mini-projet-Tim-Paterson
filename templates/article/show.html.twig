{% extends 'base.html.twig' %}

{% block title %}Article : {{ article.title }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        
        <header class="mb-5">
            <div class="mb-3">
                {% if article.Category.name is defined %}
                    <span class="badge bg-primary rounded-pill px-3 py-2 shadow-sm">
                        <i class="fas fa-tag me-1"></i> {{ article.Category.name }}
                    </span>
                {% endif %}
            </div>
            
            <h1 class="fw-black display-3 mb-4 text-dark">{{ article.title }}</h1>
            
            <div class="d-flex align-items-center text-secondary py-3 border-bottom">
                <i class="fas fa-user-circle fa-2x me-2 text-primary"></i>
                <div>
                    <span class="d-block fw-bold text-dark">
                        {% if article.Author %}
                            {{ article.Author.email|split('@')[0]|capitalize }}
                        {% else %}
                            Auteur Anonyme
                        {% endif %}
                    </span>
                    <small>ID de l'article : #{{ article.id }}</small>
                </div>
            </div>
        </header>

        <div class="article-body mb-5 lead text-dark opacity-90" style="line-height: 1.8; white-space: pre-line;">
            {{ article.content }}
        </div>

        <div class="d-flex justify-content-between align-items-center border-top pt-4 mt-5">
            <a href="{{ path('article_index') }}" class="btn btn-link text-decoration-none text-muted p-0">
                <i class="fas fa-chevron-left me-2"></i> Revenir à la liste
            </a>

            {% if app.user and (article.Author == app.user or app.user.id == 1) %}
                <div class="d-flex gap-2">
                    <a href="{{ path('article_edit', {'id': article.id}) }}" class="btn btn-outline-warning px-4 shadow-sm">
                        <i class="fas fa-edit me-1"></i> Modifier
                    </a>
                    {{ include('article/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>
        
    </div>
</div>
{% endblock %}
