                            <span class="fw-bold">{{ app.user.userIdentifier|split('@')[0]|capitalize }}</span>
                        </div>
                        <a class="btn btn-sm btn-outline-danger rounded-pill px-3" href="{{ path('app_logout') }}">
                            <i class="fas fa-sign-out-alt"></i>
