<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-3 mb-4">
    <div class="container">
        
    <a class="navbar-brand fw-bold fs-4 text-uppercase" href="{{ path('article_index') }}">
    TIM PATERSON
    </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNavDropdown">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') == 'article_index' %}active{% endif %}" href="{{ path('article_index') }}">Articles</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') == 'category_index' %}active{% endif %}" href="{{ path('category_index') }}">Catégories</a>
                </li>
                
                {% if app.user %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            Actions
                        </a>
                        <ul class="dropdown-menu border-0 shadow">
                            <li><a class="dropdown-item" href="{{ path('article_new') }}"><i class="fas fa-plus me-2 text-primary"></i>Ajouter un article</a></li>
                            <li><a class="dropdown-item" href="{{ path('category_new') }}"><i class="fas fa-folder-plus me-2 text-primary"></i>Ajouter une catégorie</a></li>
                        </ul>
                    </li>
                {% endif %}
            </ul>

            <div class="d-flex align-items-center gap-3">
                
                <form class="d-none d-xl-flex" action="{{ path('article_index') }}" method="GET">
                    <div class="input-group input-group-sm">
                        <select class="form-select border-0 bg-secondary text-white" name="article_filter" style="width: 100px;">
                            <option selected value="titre">Titre</option>
                            <option value="categorie">Catégorie</option>
                            <option value="auteur">Auteur</option>
                        </select>
                        <input type="search" class="form-control border-0" name="search" placeholder="Rechercher..." style="width: 150px;">
