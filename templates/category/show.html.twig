{% extends 'base.html.twig' %}

{% block title %}Catégorie{% endblock %}

{% block body %}
    <h1>Catégorie</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ category.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ category.name }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('category_index') }}">Revenir à la liste</a>
	{% if app.user and app.user.id == 1 %}
		<a href="{{ path('category_edit', {'id': category.id}) }}">Modifier</a>

		{{ include('category/_delete_form.html.twig') }}
	{% endif %}
{% endblock %}
