{{ form_start(form) }}
    <div class="mb-4">
        {{ form_label(form.name, 'Nom de la catégorie', {'label_attr': {'class': 'fw-bold mb-2 text-dark'}}) }}
        {{ form_widget(form.name, {
            'attr': {
                'class': 'form-control form-control-lg border-0 bg-white shadow-sm',
                'placeholder': 'Ex: Actualités, Tutoriels...'
            }
        }) }}
        {{ form_errors(form.name) }}
    </div>

    <div class="mt-4">
        <button class="btn btn-dark btn-lg w-100 rounded-pill shadow-sm py-3">
            <i class="fas fa-check-circle me-2"></i> {{ button_label|default('Enregistrer la catégorie') }}
        </button>
    </div>
{{ form_end(form) }}
