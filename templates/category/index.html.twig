{% extends 'base.html.twig' %}

{% block title %}Liste des catégories{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        
        <div class="text-center mb-5">
            <h1 class="fw-black display-4 text-dark">Catégories</h1>
            <p class="text-secondary lead">Explorez les articles par sujet de conversation.</p>
        </div>

        <div class="d-flex flex-wrap justify-content-center gap-3">
            {% for category in categories %}
                <div class="d-flex align-items-center bg-white shadow-sm rounded-pill px-4 py-2 border-0">
                    <span class="fw-bold text-dark me-3">{{ category.name }}</span>
                    
                    <div class="d-flex gap-2 border-start ps-3">
                        <a href="{{ path('category_show', {'id': category.id}) }}" class="text-primary" title="Voir plus">
                            <i class="fas fa-eye"></i>
                        </a>
                        
                        {% if app.user and app.user.id == 1 %}
                            <a href="{{ path('category_edit', {'id': category.id}) }}" class="text-warning" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5">
                    <p class="text-muted italic">Aucune catégorie n'a été créée pour le moment.</p>
                </div>
            {% endfor %}
        </div>

        {% if app.user and app.user.id == 1 %}
            <div class="text-center mt-5 border-top pt-4">
                <a href="{{ path('category_new') }}" class="btn btn-dark btn-lg rounded-pill px-5 shadow-sm">
                    <i class="fas fa-plus-circle me-2"></i> Ajouter une catégorie
                </a>
            </div>
        {% endif %}

    </div>
</div>
{% endblock %}
